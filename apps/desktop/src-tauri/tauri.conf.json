{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Loomo",
	"version": "0.1.0",
	"identifier": "com.loomo.desktop",
	"build": {
		"beforeDevCommand": "bun run --cwd ../web dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "bun run --cwd ../web build:desktop",
		"frontendDist": "../../web/build-desktop"
	},
	"app": {
		"windows": [
			{
				"title": "Loomo",
				"width": 1440,
				"height": 900,
				"minWidth": 1024,
				"minHeight": 640,
				"resizable": true,
				"center": true,
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
				"font-src": "'self' https://fonts.gstatic.com data:",
				"img-src": "'self' asset: http://asset.localhost data: blob: https:",
				"media-src": "'self' asset: http://asset.localhost data: blob: https: http://localhost:8080",
				"worker-src": "'self' blob:",
				"connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https: http://localhost:8080"
			},
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["$APPDATA/**", "$APPCACHE/**", "$VIDEO/**", "$DOWNLOAD/**"]
				}
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": false,
		"category": "Video",
		"shortDescription": "Record, edit and share screen videos",
		"longDescription": "Loomo is a screen recorder and multi-track video editor. Record your screen and camera, cut on a timeline, and export with a bundled native FFmpeg — entirely offline.",
		"copyright": "© 2026 Loomo",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/loomo-ffmpeg", "binaries/loomo-ffprobe"],
		"linux": {
			"deb": {
				"depends": []
			},
			"appimage": {
				"bundleMediaFramework": false
			}
		},
		"macOS": {
			"minimumSystemVersion": "10.15",
			"entitlements": "entitlements.plist"
		},
		"windows": {
			"nsis": {
				"installMode": "perMachine"
			}
		}
	}
}
